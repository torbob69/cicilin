{
  "expo": {
    "name": "cicil.in",
    "slug": "cicilin-user",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cicilin.user"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0c0f0b"
      },
      "package": "com.cicilin.user",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0c0f0b"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cicilin needs access to your photos for KYC document upload.",
          "cameraPermission": "Cicilin needs access to your camera for liveness check."
        }
      ]
    ],
    "scheme": "cicilin",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe404ed1-cc56-4233-9373-026c0875535a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fe404ed1-cc56-4233-9373-026c0875535a"
    }
  }
}
