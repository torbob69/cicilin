# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=your_secret_key_here_run_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (MySQL via Laragon) ──────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/cicilin

# ── ML Model ──────────────────────────────────────────────────────────────────
MODEL_PATH=app/ml/best_model_gradient_boosting.pkl
ML_CONFIDENCE_THRESHOLD=0.75

# PPP conversion factor (World Bank 2024: 4748 IDR per international dollar)
PPP_FACTOR=4750

# ── Cloudinary (KTP / KK / selfie / bank letter storage) ─────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── OTP — WhatsApp via Fonnte ─────────────────────────────────────────────────
# Leave empty in development: OTP will be printed to the console instead
FONNTE_API_KEY=your_fonnte_api_key

# ── Payment ───────────────────────────────────────────────────────────────────
# Mock / simulated payment — no external gateway required
